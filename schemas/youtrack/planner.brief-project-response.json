{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform/contracts/youtrack/planner.brief-project-response",
  "title": "PlannerBriefProjectResponse",
  "description": "The `data` payload of a 200 answer from `POST /plans/from-brief` (`{\"data\": ...}`), built by `BriefProjectService._result` in `brief_project.py`. `status` is `partial` when any epic or task failed (a retry creates only the missing ones) and `complete` otherwise; only a complete result is stored and replayed. Nothing here carries a credential or a raw upstream body.",
  "type": "object",
  "required": [
    "idempotencyKey",
    "status",
    "briefId",
    "briefHash",
    "project",
    "appName",
    "stage",
    "stateFields",
    "epics",
    "ownerSteps",
    "plannerEditsEnv",
    "note",
    "replayed"
  ],
  "additionalProperties": false,
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "sha256 of `<brief hash>:<project key>` when the scope is `epics`; for scope `tasks` or `all` the scope is part of the input (`<brief hash>:<project key>:<scope>`)."
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "briefId": {
      "type": "string"
    },
    "briefHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "shortName",
        "name",
        "isNew",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "shortName": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "isNew": {
          "type": "boolean",
          "description": "true when this run created the project, false when it reused an existing one."
        },
        "url": {
          "type": "string"
        }
      }
    },
    "appName": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "present",
        "values",
        "missing"
      ],
      "additionalProperties": false,
      "description": "The `Stage` state field. Values the planner creates on a new project: Plan, Develop, Review, Staging, Done.",
      "properties": {
        "present": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "enum": [
              "Plan",
              "Develop",
              "Review",
              "Staging"
            ]
          }
        }
      }
    },
    "stateFields": {
      "type": "object",
      "required": [
        "fields",
        "readField",
        "note",
        "hint"
      ],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "State-type field names of the project, in its order."
        },
        "readField": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "epics": {
      "type": "object",
      "required": [
        "created",
        "alreadyPresent",
        "failed"
      ],
      "additionalProperties": false,
      "properties": {
        "created": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "id",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "description": "Readable issue id, e.g. TUT-1."
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "alreadyPresent": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "id",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "id": {
                "type": "string",
                "description": "Readable issue id, e.g. TUT-1."
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "title",
              "code",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "code": {
                "enum": [
                  "tracker_rejected",
                  "tracker_unavailable",
                  "tracker_auth_rejected",
                  "tracker_not_configured",
                  "field_conflict",
                  "not_attempted"
                ],
                "description": "The planner error code of the failed write, or `not_attempted`."
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ownerSteps": {
      "type": "array",
      "description": "What the owner still has to do; the planner never edits its own environment.",
      "items": {
        "type": "object",
        "required": [
          "code",
          "what",
          "setting",
          "value",
          "command"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "add_project_key",
              "set_state_field",
              "add_stage_field",
              "complete_stage_values"
            ]
          },
          "what": {
            "type": "string"
          },
          "setting": {
            "type": [
              "string",
              "null"
            ]
          },
          "value": {
            "type": [
              "string",
              "null"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "description": "Command text the owner runs (`cd youtrack && docker compose up -d backlog-planner`), or null when the step is done in YouTrack."
          }
        }
      }
    },
    "plannerEditsEnv": {
      "const": false,
      "description": "Always false: the planner never edits its environment."
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "replayed": {
      "type": "boolean",
      "description": "true when this is the stored first result of the same brief hash and project key; this call wrote nothing."
    },
    "scope": {
      "enum": [
        "epics",
        "tasks",
        "all"
      ],
      "description": "The scope the planner ran (the request's `scope`, `epics` when it was omitted). Absent in answers produced before this property existed; a reader treats absent as `epics`."
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "alreadyPresent",
        "failed"
      ],
      "description": "The child tasks, with the same three lists as `epics`; each item names its own outcome key and its parent epic's key. When the scope is `epics` this object is ABSENT (the planner omits it); an empty object with three empty lists is also valid, so old answers and a reader that tolerates either form both validate. A `partial` status also covers failed tasks (a retry creates only the missing ones).",
      "properties": {
        "created": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskCreated"
          }
        },
        "alreadyPresent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskCreated"
          }
        },
        "failed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskFailed"
          }
        }
      }
    },
    "setup": {
      "$ref": "#/$defs/setup"
    }
  },
  "$defs": {
    "taskCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "epicKey",
        "title",
        "id",
        "url"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "The task's own outcome key."
        },
        "epicKey": {
          "type": "string",
          "description": "The outcome key of the parent epic (the `key` of an item in `epics`)."
        },
        "title": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "description": "Readable issue id, e.g. TUT-7."
        },
        "url": {
          "type": "string"
        }
      }
    },
    "taskFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "epicKey",
        "title",
        "code",
        "reason"
      ],
      "properties": {
        "key": {
          "type": "string",
          "description": "The task's own outcome key."
        },
        "epicKey": {
          "type": "string",
          "description": "The outcome key of the parent epic (the `key` of an item in `epics`)."
        },
        "title": {
          "type": "string"
        },
        "code": {
          "enum": [
            "tracker_rejected",
            "tracker_unavailable",
            "tracker_auth_rejected",
            "tracker_not_configured",
            "field_conflict",
            "not_attempted"
          ],
          "description": "The planner error code of the failed write, or `not_attempted` (for example a task whose parent epic failed)."
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "state",
        "localOnly",
        "steps"
      ],
      "description": "The project's setup step, 'task 0': what the platform does by itself after the owner presses Hand over, before task 1 becomes startable. Fixed shape shared by Factory's hand-over status, the planner's from-brief answer and the dashboard. `steps` is ordered as `app-repo`, `hexagon-repo`, `onboard`, `register-project`, `verify-discovery`. When `localOnly` is true no remote is created and nothing is published: `app-repo` and `hexagon-repo` are `skipped`. `state` of the whole step: `pending` (no step started), `running` (a step is running or some are still pending after others are done), `done` (every step is `done` or `skipped`), `failed` (a step failed). No property carries a credential.",
      "properties": {
        "name": {
          "const": "Set up repositories",
          "description": "Fixed task name; a constant so Factory, the planner and the dashboard agree on it."
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed"
          ]
        },
        "localOnly": {
          "type": "boolean",
          "description": "The owner's 'Local only' choice from the hand-over request, echoed."
        },
        "steps": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/setupStep"
          },
          "description": "Ordered; at most one entry per step id."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the setup object last changed."
        }
      }
    },
    "setupStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "state"
      ],
      "properties": {
        "id": {
          "enum": [
            "app-repo",
            "hexagon-repo",
            "onboard",
            "register-project",
            "verify-discovery"
          ],
          "description": "Closed set: `app-repo` creates the app repository, `hexagon-repo` the hexagon repository, `onboard` onboards the app, `register-project` registers the project, `verify-discovery` checks the platform discovers it."
        },
        "state": {
          "enum": [
            "pending",
            "running",
            "done",
            "failed",
            "skipped"
          ],
          "description": "`skipped` is the state of `app-repo` and `hexagon-repo` when `localOnly` is true."
        },
        "reason": {
          "enum": [
            "remote_unavailable",
            "name_taken",
            "auth_failed",
            "onboard_failed",
            "register_failed",
            "discovery_failed",
            "timeout",
            "internal_error"
          ],
          "description": "Closed short code, present when `state` is `failed`."
        },
        "detail": {
          "type": "string",
          "maxLength": 500,
          "description": "Free text for the reason; never a secret."
        },
        "at": {
          "type": "string",
          "format": "date-time",
          "description": "When this step last changed state."
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  }
}
