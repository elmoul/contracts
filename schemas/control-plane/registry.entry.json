{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform/contracts/control-plane/registry.entry",
  "title": "RegistryEntry",
  "description": "Control plane's served record for a registered hexagon (D014) — a descriptor summary plus changing state. Populated from a repo's hexagon.descriptor frontmatter plus git/CI-sourced state.",
  "type": "object",
  "required": ["functionalName", "kind", "side", "status", "repoUrl", "version", "updatedAt"],
  "properties": {
    "functionalName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "examples": ["treasury", "control-plane"]
    },
    "kind": {
      "type": "string",
      "enum": ["runtime", "app", "buildtime"]
    },
    "side": {
      "type": "string",
      "enum": ["host", "hub", "ui", "shared"]
    },
    "status": {
      "type": "string",
      "enum": ["planned", "building", "active", "suspended", "deprecated"],
      "description": "`suspended` exists only here — a registry action, not a repo property."
    },
    "repoUrl": {
      "type": "string",
      "format": "uri",
      "description": "Source repository URL."
    },
    "version": {
      "type": "string",
      "description": "Git tag where one exists, else version+shortsha.",
      "examples": ["v0.2.2", "0.1.0+14d02b2"]
    },
    "contractsPin": {
      "type": "string",
      "description": "Mirror of the descriptor's contracts.pin.",
      "examples": ["v0.2.2"]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "appId": {
      "type": "string",
      "description": "App-only. Populated when app.manifest registration arrives."
    },
    "class": {
      "type": "string",
      "enum": ["low-stakes", "health-class", "kids-class"],
      "description": "App-only. D010 risk class tier, populated when app.manifest registration arrives."
    },
    "plan": {
      "type": "string",
      "enum": ["free", "pro", "enterprise"],
      "description": "App-only. Populated when app.manifest registration arrives; enum aligned with app.manifest's plan field."
    },
    "app": {
      "type": "object",
      "description": "App-only, optional. Summary of the app's `app.descriptor` (schemas/app/descriptor.json, the repo's app.yaml), so GET /registry can carry it. Entries without it remain valid.",
      "required": ["name", "trackerKey", "layout", "ownership", "deliveryMode"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "trackerKey": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$", "description": "YouTrack project key (descriptor tracker.youtrack)." },
        "layout": { "type": "string", "enum": ["in-repo", "wrapped"] },
        "ownership": { "type": "string", "enum": ["owned", "third-party"] },
        "deliveryMode": { "type": "string", "enum": ["full", "pr-only"] },
        "devUrl": { "type": "string", "pattern": "^https?://\\S+$", "description": "Descriptor urls.dev, when declared." }
      }
    }
  },
  "additionalProperties": false
}
